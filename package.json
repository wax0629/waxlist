{
  "name": "waxlist",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "eval:intent": "node scripts/eval-intent.mjs",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:restart": "docker compose up -d --force-recreate",
