# LLM (OpenAI-compatible; xAI or OpenAI or DashScope-compatible, etc.)
# Used for: Chinese vibe → search queries; optional reason rewrite
XAI_API_KEY=
# Or:
# OPENAI_API_KEY=
LLM_BASE_URL=https://api.x.ai/v1
# Model id for your provider
LLM_MODEL=

# YouTube Data API (v0.1 only real search source)
# Setup: docs/youtube-api-setup.md
YOUTUBE_API_KEY=

# Optional: chat rate limit per IP per minute (default 20)
# RATE_LIMIT_PER_MIN=20

# Auth.js (NextAuth v5) — required for login sessions
# Generate: openssl rand -base64 32
AUTH_SECRET=
# Production site URL (required on Vercel/hosting), e.g. https://waxlist.example.com
# AUTH_URL=https://your-domain.com
# AUTH_TRUST_HOST=true

# OTP login (email / phone) — see docs/user/email-auth.md
# AUTH_OTP_DEV=1   # only then API returns dev_code (never in production)

# --- Email (required for email OTP): Resend OR SMTP ---
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=Waxlist <onboarding@resend.dev>
#
# SMTP_HOST=smtp.163.com
# SMTP_PORT=465
# SMTP_USER=you@163.com
# SMTP_PASS=
# EMAIL_FROM=Waxlist <you@163.com>
# SMTP_SECURE=true

# SMS (optional webhook: POST { phone, code, message })
# SMS_WEBHOOK_URL=

# Comma-separated identifiers that always become 站主 on first login/signup
# First account in empty DB is also owner
# OWNER_EMAILS=you@example.com
# OWNER_PHONES=13800138000

# Postgres (local: docker compose up -d)
DATABASE_URL=postgresql://waxlist:waxlist@localhost:5432/waxlist
