# LLM (OpenAI-compatible; xAI or OpenAI or DashScope-compatible, etc.)
# Used for: Chinese vibe → search queries; optional reason rewrite
XAI_API_KEY=
# Or:
# OPENAI_API_KEY=
LLM_BASE_URL=https://api.x.ai/v1
# Model id for your provider
LLM_MODEL=

# YouTube Data API (v0.1 only real search source)
# Setup: docs/youtube-api-setup.md
YOUTUBE_API_KEY=

# Optional: chat rate limit per IP per minute (default 20)
# RATE_LIMIT_PER_MIN=20

# Auth.js (NextAuth v5) — required for login sessions
# Generate: openssl rand -base64 32
AUTH_SECRET=

# Comma-separated emails that always register/login as 站主 (owner)
# First registered user is also owner if the store is empty
# OWNER_EMAILS=you@example.com

# Postgres (local: docker compose up -d)
DATABASE_URL=postgresql://waxlist:waxlist@localhost:5432/waxlist
