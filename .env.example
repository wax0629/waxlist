# LLM (OpenAI-compatible; default xAI)
# Get key: https://console.x.ai
XAI_API_KEY=
LLM_BASE_URL=https://api.x.ai/v1
# Set to a model id available on your account (see console / docs.x.ai)
LLM_MODEL=

# YouTube Data API (v0.1 only real search source)
# Setup: docs/youtube-api-setup.md
YOUTUBE_API_KEY=
