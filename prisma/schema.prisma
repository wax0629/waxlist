// Waxlist — Postgres schema (local via docker compose)
// Roles: owner | admin | user

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id
  /// 邮箱登录；与 phone 至少填一个
  email        String?  @unique
  /// 手机号（国内 11 位规范化存储）
  phone        String?  @unique
  name         String
  /// 可选：旧版密码登录遗留字段，新流程不再使用
  passwordHash String?  @map("password_hash")
  /// owner | admin | user
  role         String   @default("user")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  releases         Release[]         @relation("ReleaseCreator")
  favorites        Favorite[]
  recommendations  Recommendation[]
  trackRecs        TrackRecommendation[]
  ratings          Rating[]
  comments         ReleaseComment[]

  @@map("users")
}

/// 登录/注册验证码（邮箱或手机）
model AuthOtp {
  id         String    @id
  /// email | phone
  channel    String
  /// 规范化后的邮箱或手机号
  target     String
  codeHash   String    @map("code_hash")
  expiresAt  DateTime  @map("expires_at")
  attempts   Int       @default(0)
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([channel, target, createdAt])
  @@map("auth_otps")
}

model Release {
  id              String   @id
  title           String
  artists         String[]
  /// single | ep | album | other
  type            String   @default("album")
  neteaseId       String?  @map("netease_id")
  neteaseUrl      String?  @map("netease_url")
  coverUrl        String?  @map("cover_url")
  tags            String[] @default([])
  description     String?
  curatorialNote  String?  @map("curatorial_note")
  /// owner | community — who first added the entry
  source          String
  /// draft | pending | published | rejected
  status          String   @default("draft")
  /// 站主是否点过红心（缓存：任一 owner 用户收藏时为 true，用于标签与排序）
  ownerLoved      Boolean  @default(false) @map("owner_loved")
  /// [{ label, url }]
  links           Json     @default("[]")
  sortOrder       Int?     @map("sort_order")
  createdById     String?  @map("created_by")
  createdBy       User?    @relation("ReleaseCreator", fields: [createdById], references: [id])
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  ratingAvg       Float?   @map("rating_avg")
  ratingCount     Int      @default(0) @map("rating_count")
  /// 曲目名列表（解析网易云时缓存）
  tracklist       String[] @default([])
  favorites       Favorite[]
  recommendations Recommendation[]
  trackRecs       TrackRecommendation[]
  ratings         Rating[]
  comments        ReleaseComment[]

  @@unique([neteaseId])
  @@index([status, source])
  @@index([ownerLoved])
  @@map("releases")
}

/// 专辑评论（可附带评分快照；IP 字段预留）
model ReleaseComment {
  id        String   @id
  releaseId String   @map("release_id")
  userId    String   @map("user_id")
  body      String
  /// 发表时的 1–10 分（可选）
  score     Int?
  /// 预留：展示用 IP 脱敏，后续再采
  ipMasked  String?  @map("ip_masked")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  release   Release  @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([releaseId, createdAt])
  @@index([userId])
  @@map("release_comments")
}

/// 专辑评分 1–10（每人每专一条，可改分）
model Rating {
  id        String   @id
  releaseId String   @map("release_id")
  userId    String   @map("user_id")
  /// 1–10 整数
  score     Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  release   Release  @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, releaseId])
  @@index([releaseId])
  @@map("ratings")
}

/// 用户推荐：首推理由 + 可选曲目；后续可再推
model Recommendation {
  id          String   @id
  releaseId   String   @map("release_id")
  userId      String   @map("user_id")
  /// 推荐理由（必填）
  reason      String
  /// 推荐曲目，换行或逗号分隔曲名
  tracks      String?
  /// 是否该发行的首条推荐
  isFirst     Boolean  @default(false) @map("is_first")
  /// pending | published | rejected
  status      String   @default("pending")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  release     Release  @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([releaseId, status])
  @@index([userId])
  @@index([status])
  @@map("recommendations")
}

/// 单曲推荐（详情页曲目列表点赞）
model TrackRecommendation {
  id        String   @id
  releaseId String   @map("release_id")
  userId    String   @map("user_id")
  /// 曲名（与 release.tracklist 对齐）
  trackName String   @map("track_name")
  createdAt DateTime @default(now()) @map("created_at")
  release   Release  @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, releaseId, trackName])
  @@index([releaseId, trackName])
  @@map("track_recommendations")
}

/// 个人红心列表：任何登录用户可收藏
model Favorite {
  id        String   @id
  userId    String   @map("user_id")
  releaseId String   @map("release_id")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  release   Release  @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  @@unique([userId, releaseId])
  @@index([userId])
  @@index([releaseId])
  @@map("favorites")
}
